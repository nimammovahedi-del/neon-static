; Neon Static - look test (stage 1). Godot 4.7, Forward+, desktop only.
; Render one look:  sh tools/render_looks.sh N        (see docs/looks/README.md)
config_version=5

[application]

config/name="Neon Static Look Test"
run/main_scene="res://scenes/street.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=8192
environment/volumetric_fog/volume_size=160
environment/volumetric_fog/volume_depth=160
environment/volumetric_fog/use_filter=1
environment/ssao/quality=3
environment/ssil/quality=3
environment/screen_space_reflection/roughness_quality=3
environment/glow/upscale_mode=1
limits/cluster_builder/max_clustered_elements=1024
limits/global_shader_variables/buffer_size=262144
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
shading/overrides/force_lambert_over_burley=false

[shader_globals]

g_noise={
"type": "sampler2D",
"value": ""
}
g_win_palette={
"type": "sampler2D",
"value": ""
}
g_wetness={
"type": "float",
"value": 0.8
}
g_puddles={
"type": "float",
"value": 0.6
}
g_rain={
"type": "float",
"value": 1.0
}
g_grime={
"type": "float",
"value": 0.6
}
g_win_lit={
"type": "float",
"value": 0.45
}
g_win_bright={
"type": "float",
"value": 1.0
}
g_win_blinds={
"type": "float",
"value": 0.5
}
g_sign_bright={
"type": "float",
"value": 1.0
}
g_shop_light={
"type": "color",
"value": Color(1, 0.9, 0.75, 1)
}
g_shop_energy={
"type": "float",
"value": 2.0
}
g_lamp_color={
"type": "color",
"value": Color(1, 0.8, 0.55, 1)
}
g_lamp_energy={
"type": "float",
"value": 6.0
}
g_led_color={
"type": "color",
"value": Color(0.3, 0.9, 1, 1)
}
g_led_energy={
"type": "float",
"value": 3.0
}
g_blinker={
"type": "color",
"value": Color(1, 0.05, 0.02, 1)
}
g_holo_color={
"type": "color",
"value": Color(0.3, 0.9, 1, 1)
}
g_tail_color={
"type": "color",
"value": Color(1, 0.04, 0.03, 1)
}
g_head_color={
"type": "color",
"value": Color(0.9, 0.95, 1, 1)
}
g_fog_color={
"type": "color",
"value": Color(0.1, 0.1, 0.15, 1)
}
g_tint_concrete={
"type": "color",
"value": Color(0.42, 0.41, 0.4, 1)
}
g_tint_brick={
"type": "color",
"value": Color(0.36, 0.17, 0.12, 1)
}
g_tint_tile={
"type": "color",
"value": Color(0.5, 0.56, 0.55, 1)
}
g_tint_panel={
"type": "color",
"value": Color(0.28, 0.31, 0.33, 1)
}
g_tower_window={
"type": "vec4",
"value": Vector4(4.0, 2.2, 0.35, 1.0)
}
g_screen_bright={
"type": "float",
"value": 1.0
}
